{
  "manifest_version": 3,
  "name": "Base Culture Score",
  "version": "1.0.0",
  "description": "Display verified Base NFT score and OG rank on x.com profiles.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://www.joinog.xyz/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
