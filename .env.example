NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64
AUTH_TRUST_HOST=true

X_CLIENT_ID=
X_CLIENT_SECRET=
# optional — X API v2 app bearer token for cron profile refresh (handle/name/avatar)
X_BEARER_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NFT_PROVIDER=alchemy
NFT_PROVIDER_API_KEY=
NFT_EXCLUDE_SPAM=true
NFT_REQUIRE_VERIFIED_CONTRACT=true
NFT_MIN_FLOOR_PRICE_ETH=0
BASESCAN_API_KEY=
CRON_SECRET=
CRON_REFRESH_LIMIT=50
BASE_RPC_URL=https://mainnet.base.org
TARGET_NFT_CONTRACT_ADDRESS=all
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OG_CARD_CONTRACT=
# 8453 = Base mainnet, 84532 = Base Sepolia testnet
NEXT_PUBLIC_OG_CARD_CHAIN_ID=8453
# deploy/verify only — image shown on the NFT (defaults to ${PUBLIC_APP_URL}/og-card.png)
OG_CARD_IMAGE_URI=
# deploy only — funded wallet private key, never commit a real value
DEPLOYER_PRIVATE_KEY=
# comma-separated X handles allowed into /admin (e.g. bobyr,teammate)
ADMIN_X_HANDLES=
